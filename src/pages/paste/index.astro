---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Paste Gallery">
  <h1>Paste Gallery</h1>
  <p class="subtitle">Visual gallery of files from <a href="https://home.codevoid.de/paste/all.html" target="_blank" rel="noopener">codevoid.de/paste</a></p>

  <div id="loading" class="loading">Loading files...</div>
  <div id="gallery" class="gallery"></div>
</BaseLayout>

<script>
  // IndexedDB setup for thumbnail caching
  const DB_NAME = 'PasteGalleryCache';
  const DB_VERSION = 2; // Updated for new square crop format
  const STORE_NAME = 'thumbnails';
  const THUMBNAIL_SIZE = 700; // 2x card size for better quality

  let db: IDBDatabase | null = null;

  async function initDB(): Promise<IDBDatabase> {
    return new Promise((resolve, reject) => {
      const request = indexedDB.open(DB_NAME, DB_VERSION);

      request.onerror = () => reject(request.error);
      request.onsuccess = () => resolve(request.result);

      request.onupgradeneeded = (event) => {
        const db = (event.target as IDBOpenDBRequest).result;
        if (!db.objectStoreNames.contains(STORE_NAME)) {
          db.createObjectStore(STORE_NAME, { keyPath: 'url' });
        }
      };
    });
  }

  async function getThumbnailFromCache(url: string): Promise<string | null> {
    if (!db) return null;

    return new Promise((resolve, reject) => {
      const transaction = db!.transaction([STORE_NAME], 'readonly');
      const store = transaction.objectStore(STORE_NAME);
      const request = store.get(url);

      request.onsuccess = () => {
        const result = request.result;
        resolve(result ? result.thumbnail : null);
      };
      request.onerror = () => resolve(null);
    });
  }

  async function saveThumbnailToCache(url: string, thumbnail: string): Promise<void> {
    if (!db) return;

    return new Promise((resolve, reject) => {
      const transaction = db!.transaction([STORE_NAME], 'readwrite');
      const store = transaction.objectStore(STORE_NAME);
      store.put({ url, thumbnail, timestamp: Date.now() });

      transaction.oncomplete = () => resolve();
      transaction.onerror = () => resolve(); // Fail silently
    });
  }

  async function createThumbnail(imageUrl: string): Promise<string> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';

      img.onload = () => {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');

        if (!ctx) {
          reject(new Error('Could not get canvas context'));
          return;
        }

        // Create square thumbnail by cropping from center
        const size = THUMBNAIL_SIZE;
        canvas.width = size;
        canvas.height = size;

        // Calculate scaling to ensure image covers the square
        const scale = Math.max(size / img.width, size / img.height);
        const scaledWidth = img.width * scale;
        const scaledHeight = img.height * scale;

        // Calculate crop position (center)
        const x = (size - scaledWidth) / 2;
        const y = (size - scaledHeight) / 2;

        // Draw scaled and centered image
        ctx.drawImage(img, x, y, scaledWidth, scaledHeight);

        // Convert to data URL with compression
        const thumbnail = canvas.toDataURL('image/jpeg', 0.85);
        resolve(thumbnail);
      };

      img.onerror = () => {
        // If thumbnail creation fails, use original URL
        resolve(imageUrl);
      };

      img.src = imageUrl;
    });
  }

  // File type detection
  const imageExtensions = ['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg', 'bmp'];
  const videoExtensions = ['mp4', 'webm', 'mov', 'avi'];
  const codeExtensions = ['js', 'ts', 'py', 'c', 'cpp', 'h', 'rs', 'go', 'java', 'sh', 'lua', 'pl', 'rb'];
  const docExtensions = ['pdf', 'txt', 'md', 'doc', 'docx', 'odt'];

  function getFileType(ext: string): string {
    if (imageExtensions.includes(ext)) return 'image';
    if (videoExtensions.includes(ext)) return 'video';
    if (codeExtensions.includes(ext)) return 'code';
    if (docExtensions.includes(ext)) return 'document';
    return 'other';
  }

  async function loadImageCard(file: {name: string, url: string, extension: string}, cardContent: HTMLElement) {
    // Try to get cached thumbnail first
    const cached = await getThumbnailFromCache(file.url);

    if (cached) {
      // Use cached thumbnail immediately as background
      cardContent.style.backgroundImage = `url(${cached})`;
    } else {
      // Show loading placeholder
      const loadingDiv = document.createElement('div');
      loadingDiv.className = 'image-loading';
      loadingDiv.textContent = '...';
      cardContent.appendChild(loadingDiv);

      // Create and cache thumbnail
      try {
        const thumbnail = await createThumbnail(file.url);
        await saveThumbnailToCache(file.url, thumbnail);

        cardContent.style.backgroundImage = `url(${thumbnail})`;
        cardContent.removeChild(loadingDiv);
      } catch (error) {
        // Fallback to original image as background
        cardContent.style.backgroundImage = `url(${file.url})`;
        if (loadingDiv.parentNode) {
          cardContent.removeChild(loadingDiv);
        }
      }
    }
  }

  async function loadGallery() {
    const loadingEl = document.getElementById('loading');
    const galleryEl = document.getElementById('gallery');

    try {
      // Initialize IndexedDB
      db = await initDB();

      const response = await fetch('https://home.codevoid.de/paste/all.html');
      const html = await response.text();

      // Parse links from the HTML
      const linkRegex = /<a href="\/paste\/([^"]+)">([^<]+)<\/a>/g;
      const files: Array<{name: string, url: string, extension: string}> = [];
      let match;

      while ((match = linkRegex.exec(html)) !== null) {
        const filename = match[1];
        const extension = filename.split('.').pop()?.toLowerCase() || '';
        files.push({
          name: filename,
          url: `https://home.codevoid.de/paste/${filename}`,
          extension
        });
      }

      // Hide loading, show gallery
      if (loadingEl) loadingEl.style.display = 'none';

      // Render cards
      if (galleryEl) {
        files.forEach(file => {
          const fileType = getFileType(file.extension);
          const card = document.createElement('a');
          card.href = file.url;
          card.target = '_blank';
          card.rel = 'noopener';
          card.className = `card ${fileType}`;

          const cardContent = document.createElement('div');
          cardContent.className = 'card-content';

          if (fileType === 'image') {
            // Load image with caching
            loadImageCard(file, cardContent);
          } else if (fileType === 'video') {
            const placeholder = document.createElement('div');
            placeholder.className = 'video-placeholder';
            placeholder.innerHTML = `
              <span class="icon">▶</span>
              <span class="extension">.${file.extension}</span>
            `;
            cardContent.appendChild(placeholder);
          } else {
            const placeholder = document.createElement('div');
            placeholder.className = 'file-placeholder';
            placeholder.innerHTML = `<span class="extension">.${file.extension}</span>`;
            cardContent.appendChild(placeholder);
          }

          const cardFooter = document.createElement('div');
          cardFooter.className = 'card-footer';
          cardFooter.innerHTML = `<span class="filename">${file.name}</span>`;

          card.appendChild(cardContent);
          card.appendChild(cardFooter);
          galleryEl.appendChild(card);
        });
      }
    } catch (error) {
      if (loadingEl) {
        loadingEl.textContent = 'Failed to load files. Please check your connection.';
        loadingEl.className = 'loading error';
      }
      console.error('Failed to load paste gallery:', error);
    }
  }

  // Load on page load
  loadGallery();
</script>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .subtitle {
    margin-bottom: 2rem;
    color: #666;
  }

  .subtitle a {
    color: #000;
    text-decoration: underline;
  }

  .loading {
    padding: 2rem;
    text-align: center;
    color: #666;
  }

  .loading.error {
    color: #d00;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem;
    margin-top: 2rem;
    padding: 1rem 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: none;
    background: #fff;
    text-decoration: none;
    color: #000;
    overflow: hidden;
    transition: all 0.3s ease;
    height: 100%;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  .card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
  }

  .card-content {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8f9fa;
    overflow: hidden;
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .card.image .card-content {
    background-color: #f5f5f5;
  }

  .image-loading {
    font-size: 2rem;
    color: #999;
  }

  .video-placeholder,
  .file-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    gap: 0.5rem;
  }

  .video-placeholder .icon {
    font-size: 3rem;
  }

  .extension {
    font-family: monospace;
    font-size: 1.5rem;
    font-weight: bold;
  }

  .file-placeholder .extension {
    font-size: 2rem;
  }

  .card-footer {
    padding: 1.25rem 1.5rem;
    border-top: none;
    background: linear-gradient(to bottom, #fafafa 0%, #fff 100%);
    flex-shrink: 0;
    min-height: 80px;
    display: flex;
    align-items: center;
  }

  .filename {
    font-size: 0.9rem;
    word-break: break-word;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', monospace;
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: #2c3e50;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .gallery {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 2rem;
    }

    .card-footer {
      min-height: 70px;
      padding: 1rem 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .gallery {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .card {
      border-radius: 12px;
    }
  }
</style>

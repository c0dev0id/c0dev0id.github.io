---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Paste Gallery">
  <h1>Paste Gallery</h1>
  <p class="subtitle">Visual gallery of files from <a href="https://home.codevoid.de/paste/all.html" target="_blank" rel="noopener">codevoid.de/paste</a></p>

  <div id="loading" class="loading">Loading files...</div>
  <div id="gallery" class="gallery"></div>
</BaseLayout>

<script>
  // IndexedDB setup for thumbnail caching
  const DB_NAME = 'PasteGalleryCache';
  const DB_VERSION = 5; // Updated for new preview system
  const STORE_NAME = 'thumbnails';
  const THUMBNAIL_SIZE = 700; // 2x card size for better quality

  let db: IDBDatabase | null = null;
  let currentlyPlayingAudio: HTMLAudioElement | null = null;
  let currentlyPlayingVideo: HTMLVideoElement | null = null;

  async function initDB(): Promise<IDBDatabase> {
    return new Promise((resolve, reject) => {
      const request = indexedDB.open(DB_NAME, DB_VERSION);

      request.onerror = () => reject(request.error);
      request.onsuccess = () => resolve(request.result);

      request.onupgradeneeded = (event) => {
        const db = (event.target as IDBOpenDBRequest).result;
        if (!db.objectStoreNames.contains(STORE_NAME)) {
          db.createObjectStore(STORE_NAME, { keyPath: 'url' });
        }
      };
    });
  }

  async function getThumbnailFromCache(url: string): Promise<string | null> {
    if (!db) return null;

    return new Promise((resolve, reject) => {
      const transaction = db!.transaction([STORE_NAME], 'readonly');
      const store = transaction.objectStore(STORE_NAME);
      const request = store.get(url);

      request.onsuccess = () => {
        const result = request.result;
        resolve(result ? result.thumbnail : null);
      };
      request.onerror = () => resolve(null);
    });
  }

  async function saveThumbnailToCache(url: string, thumbnail: string): Promise<void> {
    if (!db) return;

    return new Promise((resolve, reject) => {
      const transaction = db!.transaction([STORE_NAME], 'readwrite');
      const store = transaction.objectStore(STORE_NAME);
      store.put({ url, thumbnail, timestamp: Date.now() });

      transaction.oncomplete = () => resolve();
      transaction.onerror = () => resolve(); // Fail silently
    });
  }

  async function createThumbnail(imageUrl: string): Promise<string> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';

      img.onload = () => {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');

        if (!ctx) {
          reject(new Error('Could not get canvas context'));
          return;
        }

        // Create 16:10 thumbnail by cropping from center
        const width = THUMBNAIL_SIZE;
        const height = Math.round(THUMBNAIL_SIZE * 10 / 16); // 16:10 aspect ratio
        canvas.width = width;
        canvas.height = height;

        // Calculate scaling to ensure image covers the rectangle
        const scale = Math.max(width / img.width, height / img.height);
        const scaledWidth = img.width * scale;
        const scaledHeight = img.height * scale;

        // Calculate crop position (center)
        const x = (width - scaledWidth) / 2;
        const y = (height - scaledHeight) / 2;

        // Draw scaled and centered image
        ctx.drawImage(img, x, y, scaledWidth, scaledHeight);

        // Convert to data URL with compression
        const thumbnail = canvas.toDataURL('image/jpeg', 0.85);
        resolve(thumbnail);
      };

      img.onerror = () => {
        // If thumbnail creation fails, use original URL
        resolve(imageUrl);
      };

      img.src = imageUrl;
    });
  }


  async function detectFileTypeFromBytes(fileUrl: string): Promise<string> {
    try {
      // Fetch first 1KB of file
      const response = await fetch(fileUrl, {
        headers: { 'Range': 'bytes=0-1023' }
      });

      const buffer = await response.arrayBuffer();
      const bytes = new Uint8Array(buffer);

      // Check magic numbers for common file types
      if (bytes.length >= 4) {
        // PDF
        if (bytes[0] === 0x25 && bytes[1] === 0x50 && bytes[2] === 0x44 && bytes[3] === 0x46) {
          return 'pdf';
        }
        // ZIP/Archive
        if (bytes[0] === 0x50 && bytes[1] === 0x4B) {
          return 'archive';
        }
        // ELF binary
        if (bytes[0] === 0x7F && bytes[1] === 0x45 && bytes[2] === 0x4C && bytes[3] === 0x46) {
          return 'binary';
        }
        // JPEG
        if (bytes[0] === 0xFF && bytes[1] === 0xD8 && bytes[2] === 0xFF) {
          return 'image';
        }
        // PNG
        if (bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4E && bytes[3] === 0x47) {
          return 'image';
        }
        // GIF
        if (bytes[0] === 0x47 && bytes[1] === 0x49 && bytes[2] === 0x46) {
          return 'image';
        }
      }

      // Check if text (printable ASCII or UTF-8)
      let textChars = 0;
      for (let i = 0; i < Math.min(bytes.length, 512); i++) {
        if ((bytes[i] >= 32 && bytes[i] <= 126) || bytes[i] === 9 || bytes[i] === 10 || bytes[i] === 13) {
          textChars++;
        }
      }

      if (textChars / Math.min(bytes.length, 512) > 0.85) {
        return 'text';
      }

      return 'binary';
    } catch (error) {
      console.error('Failed to detect file type:', error);
      return 'other';
    }
  }


  // File type detection
  const imageExtensions = ['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg', 'bmp'];
  const videoExtensions = ['mp4', 'webm', 'mov', 'avi', 'mkv', 'flv'];
  const audioExtensions = ['mp3', 'wav', 'ogg', 'flac', 'm4a', 'aac'];
  const archiveExtensions = ['zip', 'tar', 'gz', 'bz2', 'xz', 'rar', '7z', 'tgz'];
  const codeExtensions = ['js', 'ts', 'py', 'c', 'cpp', 'h', 'rs', 'go', 'java', 'sh', 'lua', 'pl', 'rb', 'php', 'css', 'html', 'json', 'xml', 'yaml', 'yml'];
  const docExtensions = ['pdf', 'txt', 'md', 'doc', 'docx', 'odt', 'rtf'];
  const binaryExtensions = ['bin', 'exe', 'dll', 'so', 'dylib', 'o', 'a'];

  function getFileType(ext: string): string {
    if (imageExtensions.includes(ext)) return 'image';
    if (videoExtensions.includes(ext)) return 'video';
    if (audioExtensions.includes(ext)) return 'audio';
    if (archiveExtensions.includes(ext)) return 'archive';
    if (codeExtensions.includes(ext)) return 'code';
    if (docExtensions.includes(ext)) return 'document';
    if (binaryExtensions.includes(ext)) return 'binary';
    return 'other';
  }

  async function createKenBurnsPreview(images: string[]): Promise<HTMLCanvasElement> {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');

    if (!ctx) throw new Error('No canvas context');

    const width = THUMBNAIL_SIZE;
    const height = Math.round(THUMBNAIL_SIZE * 10 / 16);
    canvas.width = width;
    canvas.height = height;
    canvas.className = 'ken-burns-preview';

    let currentImageIndex = 0;
    let animationProgress = 0;
    const imageDuration = 1000; // 1 second per image
    const totalDuration = 3000; // 3 seconds total
    let startTime = Date.now();

    // Load all images
    const imageElements = await Promise.all(
      images.map(src => {
        return new Promise<HTMLImageElement>((resolve, reject) => {
          const img = new Image();
          img.onload = () => resolve(img);
          img.onerror = reject;
          img.src = src;
        });
      })
    );

    function animate() {
      const elapsed = Date.now() - startTime;
      const progress = (elapsed % totalDuration) / totalDuration;

      currentImageIndex = Math.floor(progress * 3);
      animationProgress = (progress * 3) % 1;

      const img = imageElements[currentImageIndex];

      if (img) {
        // Ken Burns effect: zoom and pan
        const scale = 1 + animationProgress * 0.1; // Slight zoom in
        const panX = animationProgress * 20; // Slight pan
        const panY = animationProgress * 10;

        const drawWidth = width * scale;
        const drawHeight = height * scale;
        const drawX = (width - drawWidth) / 2 - panX;
        const drawY = (height - drawHeight) / 2 - panY;

        ctx.clearRect(0, 0, width, height);
        ctx.drawImage(img, drawX, drawY, drawWidth, drawHeight);

        // Fade transition between images
        if (animationProgress > 0.8 && currentImageIndex < 2) {
          const nextImg = imageElements[currentImageIndex + 1];
          if (nextImg) {
            const fadeAlpha = (animationProgress - 0.8) / 0.2;
            ctx.globalAlpha = fadeAlpha;
            ctx.drawImage(nextImg, 0, 0, width, height);
            ctx.globalAlpha = 1;
          }
        }
      }

      requestAnimationFrame(animate);
    }

    animate();

    return canvas;
  }

  async function generatePreviewImagesFromText(fileUrl: string): Promise<string[]> {
    try {
      const response = await fetch(fileUrl);
      const text = await response.text();

      const lines = text.split('\n');
      const totalLines = lines.length;

      const previews: string[] = [];

      // Generate 3 previews from different parts: start, middle, end
      const positions = [0, Math.floor(totalLines / 2), Math.max(0, totalLines - 25)];

      for (const startLine of positions) {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');

        if (!ctx) continue;

        const width = THUMBNAIL_SIZE;
        const height = Math.round(THUMBNAIL_SIZE * 10 / 16);
        canvas.width = width;
        canvas.height = height;

        // Dark background
        ctx.fillStyle = '#1e1e1e';
        ctx.fillRect(0, 0, width, height);

        // Draw text
        const fontSize = 14;
        const lineHeight = 20;
        const padding = 20;

        ctx.font = `${fontSize}px "Consolas", "Monaco", "Courier New", monospace`;
        ctx.fillStyle = '#d4d4d4';
        ctx.textBaseline = 'top';

        const linesSlice = lines.slice(startLine, startLine + 20);
        let y = padding;

        for (const line of linesSlice) {
          if (y > height - padding) break;

          const maxChars = Math.floor((width - padding * 2) / (fontSize * 0.6));
          const displayLine = line.length > maxChars ? line.substring(0, maxChars) : line;

          ctx.fillText(displayLine, padding, y);
          y += lineHeight;
        }

        previews.push(canvas.toDataURL('image/jpeg', 0.85));
      }

      return previews;
    } catch (error) {
      console.error('Failed to generate preview images:', error);
      return [];
    }
  }

  async function generatePreviewImagesFromBinary(extension: string, fileType: string): Promise<string[]> {
    const previews: string[] = [];

    const colorSchemes = [
      {bg: '#2d1b4e', accent: '#8b5cf6'},
      {bg: '#1e3a4e', accent: '#3b82f6'},
      {bg: '#4e3a1e', accent: '#f59e0b'}
    ];

    for (let i = 0; i < 3; i++) {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');

      if (!ctx) continue;

      const width = THUMBNAIL_SIZE;
      const height = Math.round(THUMBNAIL_SIZE * 10 / 16);
      canvas.width = width;
      canvas.height = height;

      const scheme = colorSchemes[i];

      // Background
      ctx.fillStyle = scheme.bg;
      ctx.fillRect(0, 0, width, height);

      // Draw pattern based on index
      ctx.fillStyle = scheme.accent;

      if (i === 0) {
        // Draw circles
        for (let j = 0; j < 5; j++) {
          ctx.beginPath();
          ctx.arc(width / 2, height / 2, 30 + j * 20, 0, Math.PI * 2);
          ctx.globalAlpha = 0.2;
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      } else if (i === 1) {
        // Draw rectangles
        for (let j = 0; j < 4; j++) {
          ctx.globalAlpha = 0.2;
          ctx.fillRect(j * 60, 0, 40, height);
        }
        ctx.globalAlpha = 1;
      } else {
        // Draw lines
        ctx.strokeStyle = scheme.accent;
        ctx.lineWidth = 3;
        for (let j = 0; j < 6; j++) {
          ctx.globalAlpha = 0.3;
          ctx.beginPath();
          ctx.moveTo(0, j * (height / 5));
          ctx.lineTo(width, j * (height / 5) + 50);
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
      }

      // Extension badge
      ctx.fillStyle = scheme.accent;
      ctx.fillRect(width / 2 - 60, height / 2 - 30, 120, 60);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 24px sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(`.${extension.toUpperCase()}`, width / 2, height / 2);

      previews.push(canvas.toDataURL('image/jpeg', 0.85));
    }

    return previews;
  }

  async function loadAnimatedTextCard(file: {name: string, url: string, extension: string}, cardContent: HTMLElement) {
    // Try to get cached animation first
    const cached = await getThumbnailFromCache(file.url + '_animated');

    if (cached) {
      // If we have cached preview images, create animation
      const images = JSON.parse(cached);
      const canvas = await createKenBurnsPreview(images);
      cardContent.appendChild(canvas);
    } else {
      // Show loading
      const loadingDiv = document.createElement('div');
      loadingDiv.className = 'image-loading';
      cardContent.appendChild(loadingDiv);

      try {
        const images = await generatePreviewImagesFromText(file.url);

        if (images.length > 0) {
          await saveThumbnailToCache(file.url + '_animated', JSON.stringify(images));
          cardContent.removeChild(loadingDiv);

          const canvas = await createKenBurnsPreview(images);
          cardContent.appendChild(canvas);
        } else {
          cardContent.removeChild(loadingDiv);
        }
      } catch (error) {
        if (loadingDiv.parentNode) {
          cardContent.removeChild(loadingDiv);
        }
      }
    }
  }

  async function loadAnimatedBinaryCard(file: {name: string, url: string, extension: string}, fileType: string, cardContent: HTMLElement) {
    // Try to get cached animation first
    const cached = await getThumbnailFromCache(file.url + '_animated');

    if (cached) {
      const images = JSON.parse(cached);
      const canvas = await createKenBurnsPreview(images);
      cardContent.appendChild(canvas);
    } else {
      try {
        const images = await generatePreviewImagesFromBinary(file.extension, fileType);

        if (images.length > 0) {
          await saveThumbnailToCache(file.url + '_animated', JSON.stringify(images));

          const canvas = await createKenBurnsPreview(images);
          cardContent.appendChild(canvas);
        }
      } catch (error) {
        console.error('Failed to create animated preview:', error);
      }
    }
  }

  async function loadImageCard(file: {name: string, url: string, extension: string}, cardContent: HTMLElement) {
    // Try to get cached thumbnail first
    const cached = await getThumbnailFromCache(file.url);

    if (cached) {
      // Use cached thumbnail immediately as background
      cardContent.style.backgroundImage = `url(${cached})`;
    } else {
      // Show loading placeholder
      const loadingDiv = document.createElement('div');
      loadingDiv.className = 'image-loading';
      loadingDiv.textContent = '...';
      cardContent.appendChild(loadingDiv);

      // Create and cache thumbnail
      try {
        const thumbnail = await createThumbnail(file.url);
        await saveThumbnailToCache(file.url, thumbnail);

        cardContent.style.backgroundImage = `url(${thumbnail})`;
        cardContent.removeChild(loadingDiv);
      } catch (error) {
        // Fallback to original image as background
        cardContent.style.backgroundImage = `url(${file.url})`;
        if (loadingDiv.parentNode) {
          cardContent.removeChild(loadingDiv);
        }
      }
    }
  }


  async function loadVideoCard(file: {name: string, url: string, extension: string}, cardContent: HTMLElement) {
    // Create video element for 3-second preview loop
    const video = document.createElement('video');
    video.src = file.url;
    video.className = 'video-preview';
    video.loop = true;
    video.muted = true;
    video.playsInline = true;

    // Try to start at a good position (skip intro)
    video.addEventListener('loadedmetadata', () => {
      if (video.duration > 3) {
        video.currentTime = Math.min(video.duration * 0.1, 5); // Start 10% in or at 5s
      }
      video.play().catch(() => {
        // If autoplay fails, show play button overlay
        const playOverlay = document.createElement('div');
        playOverlay.className = 'play-overlay';
        playOverlay.innerHTML = '▶';
        playOverlay.onclick = (e) => {
          e.stopPropagation();
          video.play();
          playOverlay.remove();
        };
        cardContent.appendChild(playOverlay);
      });
    });

    cardContent.appendChild(video);
  }

  async function loadAudioCard(file: {name: string, url: string, extension: string}, cardContent: HTMLElement) {
    // Create animated waveform canvas
    const canvas = document.createElement('canvas');
    canvas.className = 'audio-waveform';
    canvas.width = 600;
    canvas.height = 400;
    cardContent.appendChild(canvas);

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Create audio element
    const audio = new Audio(file.url);
    audio.loop = false;

    // Create progress bar container
    const progressContainer = document.createElement('div');
    progressContainer.className = 'audio-progress-container';

    const progressBar = document.createElement('div');
    progressBar.className = 'audio-progress-bar';

    const progressFill = document.createElement('div');
    progressFill.className = 'audio-progress-fill';

    const timeDisplay = document.createElement('div');
    timeDisplay.className = 'audio-time-display';
    timeDisplay.textContent = '0:00';

    progressBar.appendChild(progressFill);
    progressContainer.appendChild(progressBar);
    progressContainer.appendChild(timeDisplay);
    cardContent.appendChild(progressContainer);

    // Progress bar click to seek
    progressBar.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();

      const rect = progressBar.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const percentage = clickX / rect.width;
      audio.currentTime = audio.duration * percentage;
    };

    // Update progress
    audio.ontimeupdate = () => {
      if (audio.duration) {
        const percentage = (audio.currentTime / audio.duration) * 100;
        progressFill.style.width = `${percentage}%`;

        const remaining = audio.duration - audio.currentTime;
        const minutes = Math.floor(remaining / 60);
        const seconds = Math.floor(remaining % 60);
        timeDisplay.textContent = `-${minutes}:${seconds.toString().padStart(2, '0')}`;
      }
    };

    // Create play/pause button
    const playButton = document.createElement('button');
    playButton.className = 'audio-play-button';
    playButton.innerHTML = '▶';
    playButton.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();

      if (audio.paused) {
        // Pause all other audio/video
        if (currentlyPlayingAudio && currentlyPlayingAudio !== audio) {
          currentlyPlayingAudio.pause();
        }
        if (currentlyPlayingVideo) {
          currentlyPlayingVideo.pause();
        }

        audio.play();
        playButton.innerHTML = '⏸';
        playButton.classList.add('playing');
        currentlyPlayingAudio = audio;
      } else {
        audio.pause();
        playButton.innerHTML = '▶';
        playButton.classList.remove('playing');
        currentlyPlayingAudio = null;
      }
    };

    audio.onended = () => {
      playButton.innerHTML = '▶';
      playButton.classList.remove('playing');
      currentlyPlayingAudio = null;
      progressFill.style.width = '0%';
      timeDisplay.textContent = '0:00';
    };

    cardContent.appendChild(playButton);

    // Colorful flowing waveform animation
    let animationFrame = 0;
    let analyserData: Uint8Array | null = null;

    // Wave points for smooth flowing animation
    const wavePoints: number[] = [];
    for (let i = 0; i < 100; i++) {
      wavePoints.push(Math.random());
    }

    // Try to create audio context for real-time visualization
    try {
      const audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
      const analyser = audioContext.createAnalyser();
      const source = audioContext.createMediaElementSource(audio);
      source.connect(analyser);
      analyser.connect(audioContext.destination);
      analyser.fftSize = 256;
      analyserData = new Uint8Array(analyser.frequencyBinCount);

      function drawWaveform() {
        requestAnimationFrame(drawWaveform);

        // Black background
        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const centerY = canvas.height / 2;
        const numWaves = 3;

        if (!audio.paused && analyserData) {
          // Draw real-time frequency data as flowing waves
          analyser.getByteFrequencyData(analyserData);

          for (let waveIdx = 0; waveIdx < numWaves; waveIdx++) {
            ctx.beginPath();

            const colors = [
              ['#ff6b35', '#f7931e', '#fdc830'], // Orange to yellow
              ['#4facfe', '#00f2fe', '#43e97b'], // Blue to cyan to green
              ['#fa709a', '#fee140', '#30cfd0']  // Pink to yellow to cyan
            ];

            const gradient = ctx.createLinearGradient(0, 0, canvas.width, 0);
            const colorSet = colors[waveIdx];
            gradient.addColorStop(0, colorSet[0]);
            gradient.addColorStop(0.5, colorSet[1]);
            gradient.addColorStop(1, colorSet[2]);

            ctx.strokeStyle = gradient;
            ctx.lineWidth = 3;
            ctx.globalAlpha = 0.7 - waveIdx * 0.15;

            for (let x = 0; x < canvas.width; x++) {
              const dataIdx = Math.floor((x / canvas.width) * analyserData.length);
              const amplitude = (analyserData[dataIdx] / 255) * 80;
              const offset = waveIdx * 20;

              const y = centerY + Math.sin(x * 0.02 + animationFrame * 0.05 + waveIdx) * amplitude + offset;

              if (x === 0) {
                ctx.moveTo(x, y);
              } else {
                ctx.lineTo(x, y);
              }
            }

            ctx.stroke();
          }

          ctx.globalAlpha = 1;
        } else {
          // Draw idle flowing waves
          for (let waveIdx = 0; waveIdx < numWaves; waveIdx++) {
            ctx.beginPath();

            const colors = [
              ['#ff6b35', '#f7931e', '#fdc830'],
              ['#4facfe', '#00f2fe', '#43e97b'],
              ['#fa709a', '#fee140', '#30cfd0']
            ];

            const gradient = ctx.createLinearGradient(0, 0, canvas.width, 0);
            const colorSet = colors[waveIdx];
            gradient.addColorStop(0, colorSet[0]);
            gradient.addColorStop(0.5, colorSet[1]);
            gradient.addColorStop(1, colorSet[2]);

            ctx.strokeStyle = gradient;
            ctx.lineWidth = 3;
            ctx.globalAlpha = 0.6 - waveIdx * 0.15;

            for (let x = 0; x < canvas.width; x++) {
              const amplitude = 30 + Math.sin(animationFrame * 0.03 + waveIdx) * 10;
              const frequency = 0.015 + waveIdx * 0.005;
              const offset = waveIdx * 15;

              const y = centerY +
                Math.sin(x * frequency + animationFrame * 0.05 + waveIdx * Math.PI * 0.5) * amplitude +
                Math.sin(x * frequency * 0.5 + animationFrame * 0.03) * (amplitude * 0.5) +
                offset;

              if (x === 0) {
                ctx.moveTo(x, y);
              } else {
                ctx.lineTo(x, y);
              }
            }

            ctx.stroke();
          }

          ctx.globalAlpha = 1;
        }

        animationFrame++;
      }

      drawWaveform();
    } catch (error) {
      // Fallback to idle animation if audio context fails
      console.error('Failed to create audio context:', error);

      function drawSimpleWaveform() {
        requestAnimationFrame(drawSimpleWaveform);

        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const centerY = canvas.height / 2;
        const numWaves = 3;

        for (let waveIdx = 0; waveIdx < numWaves; waveIdx++) {
          ctx.beginPath();

          const colors = [
            ['#ff6b35', '#f7931e', '#fdc830'],
            ['#4facfe', '#00f2fe', '#43e97b'],
            ['#fa709a', '#fee140', '#30cfd0']
          ];

          const gradient = ctx.createLinearGradient(0, 0, canvas.width, 0);
          const colorSet = colors[waveIdx];
          gradient.addColorStop(0, colorSet[0]);
          gradient.addColorStop(0.5, colorSet[1]);
          gradient.addColorStop(1, colorSet[2]);

          ctx.strokeStyle = gradient;
          ctx.lineWidth = 3;
          ctx.globalAlpha = 0.6 - waveIdx * 0.15;

          for (let x = 0; x < canvas.width; x++) {
            const amplitude = 30 + Math.sin(animationFrame * 0.03 + waveIdx) * 10;
            const frequency = 0.015 + waveIdx * 0.005;
            const offset = waveIdx * 15;

            const y = centerY +
              Math.sin(x * frequency + animationFrame * 0.05 + waveIdx * Math.PI * 0.5) * amplitude +
              Math.sin(x * frequency * 0.5 + animationFrame * 0.03) * (amplitude * 0.5) +
              offset;

            if (x === 0) {
              ctx.moveTo(x, y);
            } else {
              ctx.lineTo(x, y);
            }
          }

          ctx.stroke();
        }

        ctx.globalAlpha = 1;
        animationFrame++;
      }

      drawSimpleWaveform();
    }
  }


  function createPopupModal(file: {name: string, url: string, extension: string}, fileType: string) {
    // Create modal overlay
    const modal = document.createElement('div');
    modal.className = 'modal-overlay';

    const modalContent = document.createElement('div');
    modalContent.className = 'modal-content';

    const modalHeader = document.createElement('div');
    modalHeader.className = 'modal-header';

    const title = document.createElement('h2');
    title.textContent = file.name;
    modalHeader.appendChild(title);

    const closeButton = document.createElement('button');
    closeButton.className = 'modal-close';
    closeButton.innerHTML = '×';
    closeButton.onclick = () => {
      modal.classList.remove('active');
      setTimeout(() => modal.remove(), 300);

      // Pause any playing media
      const video = modalContent.querySelector('video') as HTMLVideoElement;
      if (video) video.pause();
    };
    modalHeader.appendChild(closeButton);

    const modalBody = document.createElement('div');
    modalBody.className = 'modal-body';

    // Create content based on file type
    if (fileType === 'image') {
      const img = document.createElement('img');
      img.src = file.url;
      img.className = 'modal-image';
      modalBody.appendChild(img);
    } else if (fileType === 'video') {
      const video = document.createElement('video');
      video.src = file.url;
      video.className = 'modal-video';
      video.controls = true;
      video.autoplay = true;

      // Pause other media when this plays
      video.onplay = () => {
        if (currentlyPlayingAudio) {
          currentlyPlayingAudio.pause();
        }
        if (currentlyPlayingVideo && currentlyPlayingVideo !== video) {
          currentlyPlayingVideo.pause();
        }
        currentlyPlayingVideo = video;
      };

      modalBody.appendChild(video);
    } else if (file.extension === 'pdf') {
      const iframe = document.createElement('iframe');
      iframe.src = file.url;
      iframe.className = 'modal-pdf';
      modalBody.appendChild(iframe);
    }

    const modalFooter = document.createElement('div');
    modalFooter.className = 'modal-footer';

    const downloadButton = document.createElement('a');
    downloadButton.className = 'download-button';
    downloadButton.innerHTML = '⬇ Download';
    downloadButton.onclick = async (e) => {
      e.preventDefault();

      try {
        // Fetch and force download with application/octet-stream
        const response = await fetch(file.url);
        const blob = await response.blob();
        const url = URL.createObjectURL(new Blob([blob], { type: 'application/octet-stream' }));

        const a = document.createElement('a');
        a.href = url;
        a.download = file.name;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      } catch (error) {
        console.error('Download failed:', error);
        // Fallback to direct link
        window.open(file.url, '_blank');
      }
    };
    modalFooter.appendChild(downloadButton);

    modalContent.appendChild(modalHeader);
    modalContent.appendChild(modalBody);
    modalContent.appendChild(modalFooter);
    modal.appendChild(modalContent);

    // Close on overlay click
    modal.onclick = (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
        setTimeout(() => modal.remove(), 300);

        const video = modalContent.querySelector('video') as HTMLVideoElement;
        if (video) video.pause();
      }
    };

    document.body.appendChild(modal);

    // Trigger animation
    setTimeout(() => modal.classList.add('active'), 10);
  }

  async function loadGallery() {
    const loadingEl = document.getElementById('loading');
    const galleryEl = document.getElementById('gallery');

    try {
      // Initialize IndexedDB
      db = await initDB();

      const response = await fetch('https://home.codevoid.de/paste/all.html');
      const html = await response.text();

      // Parse links from the HTML
      const linkRegex = /<a href="\/paste\/([^"]+)">([^<]+)<\/a>/g;
      const files: Array<{name: string, url: string, extension: string}> = [];
      let match;

      while ((match = linkRegex.exec(html)) !== null) {
        const filename = match[1];
        const extension = filename.split('.').pop()?.toLowerCase() || '';
        files.push({
          name: filename,
          url: `https://home.codevoid.de/paste/${filename}`,
          extension
        });
      }

      // Hide loading, show gallery
      if (loadingEl) loadingEl.style.display = 'none';

      // Render cards
      if (galleryEl) {
        files.forEach(async file => {
          const card = document.createElement('a');
          card.href = file.url;
          card.className = 'card';

          const cardContent = document.createElement('div');
          cardContent.className = 'card-content';

          const cardFooter = document.createElement('div');
          cardFooter.className = 'card-footer';
          cardFooter.innerHTML = `<span class="filename">${file.name}</span>`;

          card.appendChild(cardContent);
          card.appendChild(cardFooter);
          galleryEl.appendChild(card);

          // Detect file type from content
          const detectedType = await detectFileTypeFromBytes(file.url);
          const extensionType = getFileType(file.extension);

          // Prefer detected type, but use extension as fallback
          let fileType = detectedType;

          // Special handling for known extensions
          if (audioExtensions.includes(file.extension)) {
            fileType = 'audio';
          } else if (videoExtensions.includes(file.extension)) {
            fileType = 'video';
          } else if (file.extension === 'pdf') {
            fileType = 'pdf';
          } else if (detectedType === 'image') {
            fileType = 'image';
          } else if (detectedType === 'text' || codeExtensions.includes(file.extension) || docExtensions.includes(file.extension)) {
            fileType = 'text';
          } else if (detectedType === 'archive') {
            fileType = 'archive';
          } else if (detectedType === 'binary') {
            fileType = 'binary';
          } else {
            fileType = 'other';
          }

          card.classList.add(fileType);

          // For video, image, and PDF: prevent default and show popup
          if (fileType === 'image' || fileType === 'video' || fileType === 'pdf') {
            card.onclick = (e) => {
              e.preventDefault();
              createPopupModal(file, fileType);
            };
          } else {
            // For other files: open in new tab
            card.target = '_blank';
            card.rel = 'noopener';
          }

          // Load appropriate preview
          if (fileType === 'image') {
            loadImageCard(file, cardContent);
          } else if (fileType === 'video') {
            loadVideoCard(file, cardContent);
          } else if (fileType === 'audio') {
            loadAudioCard(file, cardContent);
          } else if (fileType === 'text') {
            loadAnimatedTextCard(file, cardContent);
          } else {
            loadAnimatedBinaryCard(file, fileType, cardContent);
          }
        });
      }
    } catch (error) {
      if (loadingEl) {
        loadingEl.textContent = 'Failed to load files. Please check your connection.';
        loadingEl.className = 'loading error';
      }
      console.error('Failed to load paste gallery:', error);
    }
  }

  // Load on page load
  loadGallery();
</script>

